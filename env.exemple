# Variável para nome do Projeto
COMPOSE_PROJECT_NAME=project-name

# URL autorizada do front-end
URL_FRONT = "your-url"

# Configurações de Portas do BackEnd
BACK_PORT_HOST=your-backend-port

# Credenciais do MongoDB
MONGO_HOST=your-mongo-host
MONGO_PORT=your-mongo-port
MONGO_USER=your-mongo-user
MONGO_USER_PASS=your-mongo-user-password

# Credenciais do Mongo Express
MONGOEXP_PORT=your-mongo-express-port
MONGOEXP_USER=your-mongo-express-user
MONGOEXP_USER_PASS=your-mongo-express-user-password

# JWT Secret Key 
JWT_SECRET = "your-secret-jwt"

# Cookies Config
COOKIE_SECURE = false #Alterar para false em dev, true para produção. 